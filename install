#!/bin/bash
# env-linux installer — modular Fedora Server → Niri + Dux Shell desktop.
#
#   ./install [--dry-run] [--yes] [--profile=minimal|full|custom]
#             [--host=auto|imac18-3|vm|none] [--with-extras] [--with-mango]
#
# Stages live in ./stages (numbered, executed in order), package lists in
# ./manifest, host quirks in ./hosts. Everything logs to ./setup.log.
set -euo pipefail

DOTS="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$DOTS/stages/lib.sh"

# ------------------------------------------------------------------ usage ----
show_help() {
    cat <<'EOF'
env-linux installer — Fedora Server/Minimal → Niri + Dux Shell

Usage:
  ./install [OPTIONS]

Options:
  -h, --help            Show this help and exit.
  --dry-run             Print every action without executing anything.
  -y, --yes             Non-interactive: run all stages without prompting.
  --host=HOST           auto (default) | imac18-3 | vm | none
                        auto detects via DMI product name + systemd-detect-virt.
  --with-extras         Add the extras stage (60: clang, mise runtimes, udev).
  --with-mango          Also stow the 'mango' compositor package (stage 40).

Examples:
  ./install                          # guided step-by-step interactive install
  ./install --dry-run                # full rehearsal, zero changes
  ./install --yes                    # unattended run (yes to all)
  ./install --host=vm --dry-run

Stages:
  00-repos        RPM Fusion, Terra, COPRs (DMS & DankLinux)
  10-desktop-base Core desktop packages (PipeWire audio, portals, fonts, toolkits, mise CLI tools, zsh)
  20-niri-dms     Verify Niri & DMS binaries, clean legacy paths
  30-assets       56 wallpapers, fonts, JuxCursor, dfiles-shell, zoom daemons
  35-plugins      DMS plugins (restore 5 registry plugins, clone & link custom repos)
  40-dotfiles     Stow packages (niri, dms, portals [file-picker pin], environment.d [Wayland/cursor], systemd-user, scripts)
  45-own-software Personal tools (web-app-installer: turn websites into desktop apps)
  50-services     Chrome autotheme policy dir (for dms-chrome-theme), greetd login manager, user systemd units (radius cycler & magnifier)
  60-extras       Optional extras (clang, mise runtimes, Keychron fn-mode udev rule)
  90-hardware     Host quirks (imac18-3: 5K Retina, audio DKMS, BT rescue; vm: guest agents)
EOF
}

# ------------------------------------------------------------------ args -----
DRY_RUN=false
ASSUME_YES=false
PROFILE=""
HOST_FLAG="auto"
WITH_EXTRAS=false
WITH_MANGO=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)         show_help; exit 0 ;;
        --dry-run)         DRY_RUN=true; shift ;;
        -y|--yes)          ASSUME_YES=true; shift ;;
        --profile=*)       PROFILE="${1#*=}"; shift ;;
        --host=*)          HOST_FLAG="${1#*=}"; shift ;;
        --with-extras)     WITH_EXTRAS=true; shift ;;
        --with-mango)      WITH_MANGO=true; shift ;;
        *) ui_error "Unknown option: $1 (see --help)"; exit 1 ;;
    esac
done

case "$PROFILE" in
    ""|minimal|full|custom) ;;
    *) ui_error "--profile must be minimal, full or custom (got: $PROFILE)"; exit 1 ;;
esac
case "$HOST_FLAG" in
    auto|imac18-3|vm|none) ;;
    *) ui_error "--host must be auto, imac18-3, vm or none (got: $HOST_FLAG)"; exit 1 ;;
esac

if (( EUID == 0 )); then
    ui_error "Run ./install as your normal user — stages call sudo only where needed."
    exit 1
fi

# Fresh log for every run (setup.log is gitignored).
: > "$LOG_FILE"

# --------------------------------------------------------------- detect ------
DMI_PRODUCT="(unknown)"
[[ -r /sys/devices/virtual/dmi/id/product_name ]] && DMI_PRODUCT="$(</sys/devices/virtual/dmi/id/product_name)"
VIRT="$(systemd-detect-virt 2>/dev/null || true)"
DETECTED_HOST="$(detect_host_profile)"

if [[ "$HOST_FLAG" == "auto" ]]; then
    HOST_PROFILE="$DETECTED_HOST"
else
    HOST_PROFILE="$HOST_FLAG"
    [[ "$HOST_PROFILE" == "$DETECTED_HOST" ]] \
        || ui_warn "--host=$HOST_PROFILE overrides detected hardware ($DETECTED_HOST)."
fi

# ----------------------------------------------------------- gum bootstrap ---
if ! have gum && ! is_dry_run; then
    ui_warn "gum not found — bootstrapping via dnf (needs sudo)…"
    if sudo dnf install -y gum; then
        GUM_BIN="$(command -v gum 2>/dev/null || true)"
        ui_step "gum bootstrapped"
    else
        ui_warn "gum bootstrap failed — continuing with pure-bash UI fallback."
    fi
elif ! have gum && is_dry_run; then
    ui_info "dry-run: not bootstrapping gum; pure-bash UI fallback in effect."
fi

# ---------------------------------------------------------------- banner -----
if [[ -n "$GUM_BIN" && -t 1 ]]; then
    gum style --foreground 212 --border-foreground 212 --border double \
        --padding '1 4' --margin '0 1' --align center --bold \
        "env-linux" "Fedora → Niri + Dux Shell"
else
    printf '\n%s%s%s\n' "$C_BLD$C_MAG" "══════════════════════════════════════" "$C_RST"
    printf '  %senv-linux%s — Fedora → Niri + Dux Shell\n' "$C_BLD" "$C_RST"
    printf '%s%s%s\n\n' "$C_BLD$C_MAG" "══════════════════════════════════════" "$C_RST"
fi

ui_info "Hardware : ${DMI_PRODUCT} (virt: ${VIRT:-none})"
ui_info "Host     : $HOST_PROFILE (detection said: $DETECTED_HOST)"

# -------------------------------------------------------- preflight / dux -----
check_dux_installed() {
    have dms && have niri && have dms-greeter
}

if check_dux_installed; then
    ui_step "Official Dux Shell stack detected ($(dms version 2>/dev/null || echo "installed"))"
elif ! is_dry_run; then
    ui_error "Dux Shell stack not detected (dms, niri, dms-greeter missing)."
    printf '\n  %s\n' "Please install the official Dux Shell stack first by running:"
    printf '    %s%s%scurl -fsSL https://install.duxlabs.dev | sh%s\n\n' "$C_BLD" "$C_CYN" "" "$C_RST"
    printf '  %s\n\n' "Once installed, re-run ./install to apply your customized desktop environment."
    exit 1
else
    ui_dry "preflight: check for official Dux stack (dms, niri, dms-greeter)"
fi

# ---------------------------------------------------------------- stages -----
stage_description() {
    case "$1" in
        00-repos.sh)        echo "Enable package repositories (RPM Fusion Free/Nonfree, Terra, and COPRs for DMS/Dux)" ;;
        10-desktop-base.sh) echo "Install core desktop packages (PipeWire audio, portals, fonts, toolkits, mise CLI tools, antidote, zsh)" ;;
        20-niri-dms.sh)     echo "Verify Niri compositor & DMS binaries, and clean legacy strays" ;;
        30-assets.sh)       echo "Download & install env-assets-v1 (56 wallpapers, fonts, JuxCursor, dfiles-shell, zoom daemons)" ;;
        35-plugins.sh)      echo "Install DMS plugins (restore 5 registry plugins from lockfile, clone & link custom repos)" ;;
        40-dotfiles.sh)     echo "Stow desktop dotfiles: portals (file-picker pin & mime defaults), environment.d (Wayland flags & dynamic cursor), systemd-user (radius cycler & zoom daemon), scripts" ;;
        45-own-software.sh) echo "Clone and build personal software (web-app-installer: turn websites into desktop apps)" ;;
        50-services.sh)     echo "Configure Chrome managed policy directory (for dms-chrome-theme autotheming), greetd display manager (dms-greeter with lock-screen power actions), and user systemd units" ;;
        60-extras.sh)       echo "Install optional extras (clang, mise language runtimes, Keychron fn-mode udev rule)" ;;
        90-hardware.sh)     echo "Apply hardware quirks (iMac: 5K Retina video, audio DKMS, BT rescue; VM: guest agents)" ;;
        *)                  echo "Execute $1" ;;
    esac
}

mapfile -t ALL_STAGES < <(cd "$DOTS/stages" && ls [0-9]*.sh 2>/dev/null | sort)
((${#ALL_STAGES[@]} > 0)) || { ui_error "no stage scripts found in $DOTS/stages"; exit 1; }

# Canonical stages list
ALL_STAGE_FILES=("00-repos.sh" "10-desktop-base.sh" "20-niri-dms.sh" "30-assets.sh"
                 "35-plugins.sh" "40-dotfiles.sh" "45-own-software.sh" "50-services.sh")
[[ "$WITH_EXTRAS" == "true" ]] && ALL_STAGE_FILES+=("60-extras.sh")
ALL_STAGE_FILES+=("90-hardware.sh")

RUN_STAGES=()
for s in "${ALL_STAGE_FILES[@]}"; do
    [[ -f "$DOTS/stages/$s" ]] && RUN_STAGES+=("$s")
done

if [[ "$PROFILE" == "custom" ]]; then
    if [[ "$ASSUME_YES" == "true" ]]; then
        ui_warn "--yes with custom profile is ambiguous — running standard stages."
    else
        picks="$(ui_choose_multi "Select stages to run (in order)" "${ALL_STAGES[@]}")" \
            || { ui_info "Aborted."; exit 0; }
        RUN_STAGES=()
        for s in "${ALL_STAGES[@]}"; do
            grep -qx "$s" <<<"$picks" && RUN_STAGES+=("$s")
        done
        ((${#RUN_STAGES[@]} > 0)) || { ui_error "No stages selected."; exit 1; }
    fi
elif [[ "$ASSUME_YES" != "true" ]]; then
    EXEC_MODE="$(ui_choose "How would you like to run the installer?" \
        "guided — step-by-step confirmation with narration" \
        "yes to all — run all stages automatically without prompting")" || { ui_info "Aborted."; exit 0; }
    [[ "$EXEC_MODE" =~ "yes to all" ]] && ASSUME_YES=true
fi

# --------------------------------------------------------------- summary -----
summary_box() { # summary_box TITLE COLOR rest-of-lines-on-stdin
    local title="$1" color="$2" line
    if [[ -n "$GUM_BIN" && -t 1 ]]; then
        local -a lines=()
        while IFS= read -r line; do lines+=("$line"); done
        gum style --border rounded --border-foreground "$color" --padding '0 2' \
            --margin '1 0' "$title" "${lines[@]}"
    else
        printf '\n  %s\n' "$title"
        while IFS= read -r line; do printf '  %s\n' "$line"; done
    fi
}

{
    echo "Hardware · ${DMI_PRODUCT} (virt: ${VIRT:-none})"
    echo "Host ····· $HOST_PROFILE"
    echo "Mode ····· $($ASSUME_YES && echo "Yes to all (unattended)" || echo "Guided (step-by-step)")"
    echo "Extras ··· $WITH_EXTRAS    Mango · $WITH_MANGO"
    echo "Dry run ·· $DRY_RUN"
    echo "Stages ··· ${RUN_STAGES[*]}"
} | summary_box "◆ Installation plan" 39

if ! ui_confirm "Proceed with this plan?"; then
    ui_info "Aborted — nothing was changed."
    exit 0
fi

# ---------------------------------------------------------------- run --------
export DRY_RUN HOST_PROFILE WITH_EXTRAS WITH_MANGO LOG_FILE ASSUME_YES
log INFO "=== install start: host=$HOST_PROFILE dry-run=$DRY_RUN extras=$WITH_EXTRAS mango=$WITH_MANGO ==="

declare -a OK_STAGES=()
declare -a FAIL_STAGES=()
FAILED=false

for stage in "${RUN_STAGES[@]}"; do
    desc="$(stage_description "$stage")"
    ui_header "▶ $stage"
    ui_info "$desc"

    if [[ "$ASSUME_YES" != "true" ]]; then
        if ! ui_confirm "Proceed with $stage?"; then
            ui_warn "Skipped $stage by user choice."
            continue
        fi
    fi

    if bash "$DOTS/stages/$stage"; then
        OK_STAGES+=("$stage")
    else
        FAIL_STAGES+=("$stage")
        FAILED=true
        ui_warn "Stage $stage reported errors or warnings (see $LOG_FILE)."
        if [[ "$ASSUME_YES" != "true" ]]; then
            if ! ui_confirm "Continue with the remaining stages?"; then
                ui_info "Installation stopped after $stage."
                break
            fi
        else
            ui_info "Continuing with remaining stages (--yes mode)..."
        fi
    fi
done

# --------------------------------------------------------------- summary -----
log INFO "=== install end: ok=[${OK_STAGES[*]-}] fail=[${FAIL_STAGES[*]-}] ==="

status_line() { # status_line STAGE_FILE
    local s found=false
    for s in "${OK_STAGES[@]}"; do
        [[ "$s" == "$1" ]] && { found=true; break; }
    done
    if [[ "$found" == true ]]; then
        printf '   ✔ %s\n' "$1"
    else
        printf '   ✖ %s\n' "$1"
    fi
}

{
    for s in "${RUN_STAGES[@]}"; do status_line "$s"; done
    echo "──────────────────────────────────────────────"
    echo "Log · $LOG_FILE"
    if [[ "$FAILED" == true ]]; then
        echo "Fix the failure above, then re-run ./install (stages are idempotent)."
    else
        echo "Next steps:"
        echo "  • reboot — greetd (dms-greeter → niri) takes over from the console"
        [[ "$HOST_PROFILE" == "imac18-3" ]] && \
        echo "  • iMac18,3: kernel args + DKMS audio need the reboot too"
        echo "  • log back in to pick up zsh + systemd --user units (dms, dfiles…)"
        echo "  • (optional) sync your desktop wallpaper and theme to the login screen:"
        echo "      dms-greeter sync"
    fi
} | summary_box "$([[ "$FAILED" == true ]] && echo '◆ Finished — with failures' || echo '◆ Finished — all stages OK')" \
      "$([[ "$FAILED" == true ]] && echo 203 || echo 46)"

if [[ "$FAILED" == "true" ]]; then
    exit 1
fi
exit 0
