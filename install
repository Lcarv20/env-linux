#!/bin/bash
# env-linux installer — modular Fedora Server → Niri + Dux Shell desktop.
#
#   ./install [--dry-run] [--yes] [--profile=minimal|full|custom]
#             [--host=auto|imac18-3|vm|none] [--with-extras] [--with-mango]
#
# Stages live in ./stages (numbered, executed in order), package lists in
# ./manifest, host quirks in ./hosts. Everything logs to ./setup.log.
set -euo pipefail

DOTS="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$DOTS/stages/lib.sh"

# ------------------------------------------------------------------ usage ----
show_help() {
    cat <<'EOF'
env-linux installer — Fedora Server/Minimal → Niri + Dux Shell

Usage:
  ./install [OPTIONS]

Options:
  -h, --help            Show this help and exit.
  --dry-run             Print every action without executing anything.
  -y, --yes             Non-interactive: run all stages without prompting.
  --host=HOST           auto (default) | imac18-3 | vm | none
                        auto detects via DMI product name + systemd-detect-virt.
  --with-extras         Add the extras stage (60: clang, mise runtimes, udev).
  --with-mango          Also stow the 'mango' compositor package (stage 40).

Examples:
  ./install                          # guided step-by-step interactive install
  ./install --dry-run                # full rehearsal, zero changes
  ./install --yes                    # unattended run (yes to all)
  ./install --host=vm --dry-run

Stages:
  00-repos        RPM Fusion, Terra, COPR (duxlabs/dms)
  10-desktop-base Core desktop packages (PipeWire audio, portals, fonts, toolkits, mise CLI tools, zsh)
  30-assets       56 wallpapers, fonts, JuxCursor, dfiles-shell, zoom daemons
  35-plugins      DMS plugins (restore registry plugins, clone & link custom repos)
  40-dotfiles     Stow packages (niri, dms, portals [file-picker pin], environment.d [Wayland/cursor], systemd-user, scripts)
  45-own-software Personal tools (web-app-installer: turn websites into desktop apps)
  50-services     Greetd display manager (dms-greeter), graphical session, user systemd units
  60-extras       Optional extras (clang, mise language runtimes)
  90-hardware     Host quirks (imac18-3: 5K Retina, audio DKMS, BT rescue; vm: guest agents)
EOF
}

# ------------------------------------------------------------------ args -----
DRY_RUN=false
ASSUME_YES=false
PROFILE=""
HOST_FLAG="auto"
WITH_EXTRAS=false
WITH_MANGO=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)         show_help; exit 0 ;;
        --dry-run)         DRY_RUN=true; shift ;;
        -y|--yes)          ASSUME_YES=true; shift ;;
        --profile=*)       PROFILE="${1#*=}"; shift ;;
        --host=*)          HOST_FLAG="${1#*=}"; shift ;;
        --with-extras)     WITH_EXTRAS=true; shift ;;
        --with-mango)      WITH_MANGO=true; shift ;;
        *) ui_error "Unknown option: $1 (see --help)"; exit 1 ;;
    esac
done

case "$PROFILE" in
    ""|minimal|full|custom) ;;
    *) ui_error "--profile must be minimal, full or custom (got: $PROFILE)"; exit 1 ;;
esac
case "$HOST_FLAG" in
    auto|imac18-3|vm|none) ;;
    *) ui_error "--host must be auto, imac18-3, vm or none (got: $HOST_FLAG)"; exit 1 ;;
esac

if (( EUID == 0 )); then
    ui_error "Run ./install as your normal user — stages call sudo only where needed."
    exit 1
fi

# Fresh log for every run (setup.log is gitignored).
: > "$LOG_FILE"

# --------------------------------------------------------------- detect ------
DMI_PRODUCT="(unknown)"
[[ -r /sys/devices/virtual/dmi/id/product_name ]] && DMI_PRODUCT="$(</sys/devices/virtual/dmi/id/product_name)"
VIRT="$(systemd-detect-virt 2>/dev/null || true)"
DETECTED_HOST="$(detect_host_profile)"

if [[ "$HOST_FLAG" == "auto" ]]; then
    HOST_PROFILE="$DETECTED_HOST"
else
    HOST_PROFILE="$HOST_FLAG"
    [[ "$HOST_PROFILE" == "$DETECTED_HOST" ]] \
        || ui_warn "--host=$HOST_PROFILE overrides detected hardware ($DETECTED_HOST)."
fi

# ---------------------------------------------------------------- banner -----
printf '\n %s╭──────────────────────────────────────────╮%s\n' "$C_MAG" "$C_RST"
printf ' %s│%s  %senv-linux%s  ·  Fedora → Niri + Dux Shell %s│%s\n' "$C_MAG" "$C_RST" "$C_BLD" "$C_RST" "$C_MAG" "$C_RST"
printf ' %s╰──────────────────────────────────────────╯%s\n\n' "$C_MAG" "$C_RST"

VIRT_NOTE=""; [[ -n "$VIRT" && "$VIRT" != none ]] && VIRT_NOTE=" (virt: $VIRT)"
ui_info "Machine: ${DMI_PRODUCT}${VIRT_NOTE} · host profile: ${C_BLD}$HOST_PROFILE${C_RST}"

# -------------------------------------------------------- preflight / dux -----
check_dux_installed() {
    have dms && have niri && have dms-greeter && have dfiles && have matugen
}

if check_dux_installed; then
    ui_step "Official Dux Shell stack detected ($(dms version 2>/dev/null || echo "installed"))"
elif ! is_dry_run; then
    ui_error "Dux Shell stack not detected (dms, niri, dms-greeter, dfiles, matugen)."
    printf '\n  %s\n' "Please install the official Dux Shell stack first by running:"
    printf '    %s%s%scurl -fsSL https://install.duxlabs.dev | sh%s\n\n' "$C_BLD" "$C_CYN" "" "$C_RST"
    printf '  %s\n\n' "Once installed, re-run ./install to apply your customized desktop environment."
    exit 1
else
    ui_dry "preflight: check for official Dux stack (dms, niri, dms-greeter, dfiles, matugen)"
fi

# ---------------------------------------------------------------- stages -----
stage_title() {
    case "$1" in
        00-repos.sh)        echo "Repositories" ;;
        10-desktop-base.sh) echo "Desktop base" ;;
        30-assets.sh)       echo "Assets" ;;
        35-plugins.sh)      echo "DMS plugins" ;;
        40-dotfiles.sh)     echo "Dotfiles" ;;
        45-own-software.sh) echo "Own software" ;;
        50-services.sh)     echo "Services" ;;
        60-extras.sh)       echo "Extras" ;;
        90-hardware.sh)     echo "Hardware quirks ($HOST_PROFILE)" ;;
        *)                  echo "${1%.sh}" ;;
    esac
}

stage_description() {
    case "$1" in
        00-repos.sh)        echo "RPM Fusion (free/nonfree), Terra, Dux COPR" ;;
        10-desktop-base.sh) echo "PipeWire, portals, fonts, toolkits, mise CLI tools, antidote, zsh" ;;
        30-assets.sh)       echo "Wallpapers, fonts, JuxCursor, dfiles-shell, zoom daemons" ;;
        35-plugins.sh)      echo "Restore registry plugins from lockfile, link custom plugin repos" ;;
        40-dotfiles.sh)     echo "Stow niri, dms, portals, environment.d, systemd-user, scripts" ;;
        45-own-software.sh) echo "web-app-installer (websites → desktop apps)" ;;
        50-services.sh)     echo "greetd + dms-greeter, graphical target, user systemd units" ;;
        60-extras.sh)       echo "clang, mise language runtimes" ;;
        90-hardware.sh)     echo "iMac: 5K kernel args, audio DKMS, BT rescue · VM: guest agents" ;;
        *)                  echo "Run $1" ;;
    esac
}

stage_details() {
    case "$1" in
        00-repos.sh)
            ui_why "Fedora Minimal only ships base FOSS repos — missing media codecs, Terra packages & DuxLabs COPR."
            ui_item "RPM Fusion"   "Hardware video/audio codecs & firmware (Free & Nonfree)"
            ui_item "Terra"        "Extra desktop & CLI packages from Fyra Labs"
            ui_item "DuxLabs COPR" "Official Niri, Dux Shell (dms), dms-greeter & dux-files RPMs"
            ;;
        10-desktop-base.sh)
            ui_why "Installs the OS plumbing (audio, GPU, portals, fonts, shell & CLI tools) that Niri + DMS rely on."
            ui_item "Wayland & GPU"  "Mesa GL/Vulkan/VA-API drivers, wl-clipboard, cliphist, wtype"
            ui_item "Audio & System" "PipeWire + WirePlumber, BlueZ Bluetooth, NetworkManager Wi-Fi, brightnessctl, upower"
            ui_item "Portals & UI"   "xdg-desktop-portal (gtk/gnome), polkit, GTK3/4, Qt6 Wayland, Noto & JetBrains Mono fonts"
            ui_item "Shell & CLI"    "zsh (default login shell), Antidote, mise + core tools (nvim, fzf, rg, fd, bat, delta, lazygit, starship, zoxide, lsd, gh)"
            ;;
        30-assets.sh)
            ui_why "Fetches heavy binary assets (wallpapers, cursors, fonts, QML shells) kept out of git history."
            ui_item "Release bundle"  "Downloads & verifies env-assets-v1.tar.zst into ~/.cache/env-linux-assets"
            ui_item "Wallpapers"      "Extracts 56 wallpapers to ~/Pictures/Walpapers (+ ~/Pictures/Wallpapers symlink)"
            ui_item "Cursors & Fonts" "Installs JuxCursor/icons (~/.local/share/icons), Adwaita fallback & custom fonts"
            ui_item "dfiles-shell"    "Installs ~/.config/dfiles-shell & patches dux-files QML for dynamic Material 3 colors"
            ui_item "Helper binaries" "Installs bundled zoom/helper daemons into ~/.local/bin"
            ;;
        35-plugins.sh)
            ui_why "Restores official Dux Shell widgets and clones/links your custom Material 3 & hardware plugins."
            ui_item "Registry plugins"   "Restores official plugins from dms/.config/dms/plugins.lock.json"
            ui_item "dms-dynamic-cursor" "Clones & links SVG cursor plugin tinted to wallpaper accent"
            ui_item "dms-chrome-theme"   "Clones & links live Material 3 theme injector for Chrome/Brave"
            ui_item "dms-cpufreq"        "Clones & links CpuFreq governor & turbo-boost bar widget"
            ;;
        40-dotfiles.sh)
            ui_why "Symlinks tracked desktop configs from ~/env-linux into \$HOME and seeds default theme state."
            ui_item "Conflict backup" "Moves any pre-existing non-symlink files into ~/.dots-backup-<timestamp>/"
            ui_item "GNU Stow"        "Stows (--no-folding): niri, dms, portals (dfiles picker pin), environment, systemd-user, scripts"
            ui_item "Cursor & Theme"  "Sets Adwaita @ 32 in GTK 3/4 & ~/.Xresources; seeds initial DMS wallpaper (rogue.jpg) & Material 3 palette"
            ;;
        45-own-software.sh)
            ui_why "Builds and installs your personal desktop tools from source."
            ui_item "web-app-installer" "Clones Lcarv20/web-app-installer to ~/Developer/Software & runs make install (turns websites into isolated desktop apps)"
            ;;
        50-services.sh)
            ui_why "Configures the graphical login screen (greetd → dms-greeter → niri) and background user daemons."
            ui_item "greetd config" "Installs /etc/greetd/config.toml & niri configs; pre-seeds /var/cache/dms-greeter/settings.json (login power menu)"
            ui_item "Boot target"   "Disables conflicting gdm/sddm, enables greetd.service & sets graphical.target"
            ui_item "User services" "Enables dms, dfiles, dsearch, dux-cycle-radius.path (auto corner radius) & niri-zoomd.service (cursor zoom)"
            ;;
        60-extras.sh)
            ui_why "Optional dev toolchains and language runtimes requested via --with-extras."
            ui_item "Compiler & tools" "Installs clang via dnf"
            ui_item "Mise runtimes"    "Installs bun, node, go, rust, pnpm, lua, deno, prettier & lua-language-server"
            ;;
        90-hardware.sh)
            ui_why "Applies machine-specific hardware fixes for profile '$HOST_PROFILE' while keeping the rest of the repo portable."
            case "$HOST_PROFILE" in
                imac18-3)
                    ui_item "Kernel boot args" "Adds mem_sleep_default=s2idle, acpi_osi=!Darwin, acpi_backlight=video & video=eDP-1:5120x2880MR@60e via grubby"
                    ui_item "Audio DKMS"       "Clones & builds snd_hda_macbookpro DKMS module for iMac18,3 Cirrus Logic CS8409 speakers/mic"
                    ui_item "Bluetooth rescue" "Installs /usr/local/sbin/bt-resume-rescue + systemd-suspend drop-in to fix BT wake wedge"
                    ui_item "5K Display mode"  "Installs ~/.config/niri/dms/outputs.kdl (eDP-1 3840×2160 @ scale 1.25)"
                    ;;
                vm)
                    ui_item "VM Guest Agents" "Installs & enables qemu-guest-agent + spice-vdagent (clipboard & auto-resize)"
                    ui_item "Display outputs" "Installs generic ~/.config/niri/dms/outputs.kdl with auto-detected resolution"
                    ;;
                *)
                    ui_item "No host quirks"  "Generic hardware profile (no machine-specific kernel/DKMS hacks needed)"
                    ;;
            esac
            ;;
        *)
            ui_item "$1" "Run stage script $1"
            ;;
    esac
}

mapfile -t ALL_STAGES < <(cd "$DOTS/stages" && ls [0-9]*.sh 2>/dev/null | sort)
((${#ALL_STAGES[@]} > 0)) || { ui_error "no stage scripts found in $DOTS/stages"; exit 1; }

# Canonical stages list
ALL_STAGE_FILES=("00-repos.sh" "10-desktop-base.sh" "30-assets.sh"
                 "35-plugins.sh" "40-dotfiles.sh" "45-own-software.sh" "50-services.sh")
[[ "$WITH_EXTRAS" == "true" ]] && ALL_STAGE_FILES+=("60-extras.sh")
ALL_STAGE_FILES+=("90-hardware.sh")

RUN_STAGES=()
for s in "${ALL_STAGE_FILES[@]}"; do
    [[ -f "$DOTS/stages/$s" ]] && RUN_STAGES+=("$s")
done

if [[ "$PROFILE" == "custom" ]]; then
    if [[ "$ASSUME_YES" == "true" ]]; then
        ui_warn "--yes with custom profile is ambiguous — running standard stages."
    else
        picks="$(ui_choose_multi "Select stages to run (in order)" "${ALL_STAGES[@]}")" \
            || { ui_info "Aborted."; exit 0; }
        RUN_STAGES=()
        for s in "${ALL_STAGES[@]}"; do
            grep -qx "$s" <<<"$picks" && RUN_STAGES+=("$s")
        done
        ((${#RUN_STAGES[@]} > 0)) || { ui_error "No stages selected."; exit 1; }
    fi
elif [[ "$ASSUME_YES" != "true" ]]; then
    EXEC_MODE="$(ui_choose "How should the installer run?" \
        "Guided — confirm each stage" \
        "Automatic — run every stage without asking")" || { ui_info "Aborted."; exit 0; }
    [[ "$EXEC_MODE" == Automatic* ]] && ASSUME_YES=true
fi

# --------------------------------------------------------------- summary -----
ui_rule_top "" "Installation plan"
printf '  %sMode%s     %s%s\n' "$C_GRY" "$C_RST" \
    "$($ASSUME_YES && echo "Automatic" || echo "Guided")" \
    "$(is_dry_run && echo " · dry run (nothing will change)" || echo "")"
printf '  %sHost%s     %s (%s)\n' "$C_GRY" "$C_RST" "$HOST_PROFILE" "$DMI_PRODUCT"
printf '  %sFlags%s    Extras: %s  ·  Mango: %s\n\n' "$C_GRY" "$C_RST" "$WITH_EXTRAS" "$WITH_MANGO"

i=0
for s in "${RUN_STAGES[@]}"; do
    i=$((i + 1))
    t="$(stage_title "$s")"
    pad=$(( 28 - ${#t} )); (( pad < 2 )) && pad=2
    prefix="$(printf '  %s%2d%s  %s%s%s%*s' "$C_GRY" "$i" "$C_RST" "$C_BLD" "$t" "$C_RST" "$pad" "")"
    ui_row "$prefix" $(( 6 + ${#t} + pad )) "$(stage_description "$s")" "$C_GRY"
done
ui_rule_bottom
printf '\n'

if ! ui_confirm "Proceed with this plan?"; then
    ui_info "Aborted — nothing was changed."
    exit 0
fi

# ---------------------------------------------------------------- run --------
ENV_INSTALL_NESTED=1
export DRY_RUN HOST_PROFILE WITH_EXTRAS WITH_MANGO LOG_FILE ASSUME_YES ENV_INSTALL_NESTED
log INFO "=== install start: host=$HOST_PROFILE dry-run=$DRY_RUN extras=$WITH_EXTRAS mango=$WITH_MANGO ==="

declare -a OK_STAGES=()
declare -a FAIL_STAGES=()
declare -a SKIP_STAGES=()
FAILED=false
TOTAL=${#RUN_STAGES[@]}
IDX=0

for stage in "${RUN_STAGES[@]}"; do
    IDX=$((IDX + 1))
    ui_stage_card "$IDX" "$TOTAL" "$(stage_title "$stage")"
    stage_details "$stage"
    ui_rule_bottom

    if [[ "$ASSUME_YES" != "true" ]]; then
        case "$(ui_buttons "Run [$IDX/$TOTAL] $(stage_title "$stage")?" "Run" "Skip")" in
            Skip) SKIP_STAGES+=("$stage"); continue ;;
        esac
    fi

    if bash "$DOTS/stages/$stage"; then
        OK_STAGES+=("$stage")
    else
        FAIL_STAGES+=("$stage")
        FAILED=true
        ui_warn "$(stage_title "$stage") reported errors (details in $LOG_FILE)."
        if [[ "$ASSUME_YES" != "true" ]]; then
            if ! ui_confirm "Continue with the remaining stages?"; then
                ui_info "Installation stopped after $(stage_title "$stage")."
                break
            fi
        fi
    fi
done

# --------------------------------------------------------------- summary -----
log INFO "=== install end: ok=[${OK_STAGES[*]-}] fail=[${FAIL_STAGES[*]-}] ==="

in_list() { local x="$1"; shift; local y; for y in "$@"; do [[ "$x" == "$y" ]] && return 0; done; return 1; }

ui_rule_top "" "$([[ "$FAILED" == true ]] && echo 'Finished with failures' || echo 'Finished')"
for s in "${RUN_STAGES[@]}"; do
    t="$(stage_title "$s")"
    if   in_list "$s" "${OK_STAGES[@]}";   then printf '  %s✔%s  %s\n' "$C_GRN" "$C_RST" "$t"
    elif in_list "$s" "${FAIL_STAGES[@]}"; then printf '  %s✖%s  %s\n' "$C_RED" "$C_RST" "$t"
    elif in_list "$s" "${SKIP_STAGES[@]}"; then printf '  %s↷  %s (skipped)%s\n' "$C_GRY" "$t" "$C_RST"
    else                                        printf '  %s·  %s (not run)%s\n' "$C_GRY" "$t" "$C_RST"
    fi
done
printf '\n  %sLog:%s %s\n' "$C_GRY" "$C_RST" "$LOG_FILE"
if [[ "$FAILED" == true ]]; then
    printf '  Fix the failure above, then re-run ./install (stages are idempotent).\n'
else
    printf '\n  %s%sNext steps — run this and reboot:%s\n' "$C_BLD" "$C_YLW" "$C_RST"
    ui_item "dms-greeter sync" "Mirror your wallpaper, Material 3 theme & settings to the login screen"
    ui_item "sudo reboot"      "greetd (dms-greeter → niri) takes over the console"
    [[ "$HOST_PROFILE" == "imac18-3" ]] && \
    ui_item "iMac18,3"         "Kernel args + DKMS audio need that reboot too"
fi
ui_rule_bottom
printf '\n'

if [[ "$FAILED" == "true" ]]; then
    exit 1
fi
exit 0
