#!/usr/bin/env bash
set -euo pipefail

COLORS_FILE="${HOME}/.cache/dms/dms-colors.json"
[[ -f "$COLORS_FILE" ]] || exit 0

MODE=""

# Try to get mode from DMS/Matugen first
MODE="$(jq -r '.mode // .colorScheme // empty' "$COLORS_FILE" 2>/dev/null || true)"

# Fallback to GTK if DMS doesn't expose it
if [[ -z "$MODE" || "$MODE" == "null" ]]; then
  if command -v gsettings >/dev/null 2>&1; then
    if gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | grep -q prefer-light; then
      MODE="light"
    elif gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | grep -q prefer-dark; then
      MODE="dark"
    fi
  fi
fi

# Default to dark if still unknown
[[ -z "$MODE" || "$MODE" == "null" ]] && MODE="dark"

# Pick the matching palette
if [[ "$MODE" == "light" ]]; then
  COLOR="$(jq -r '.colors.light.surface_container // .colors.light.surface // .colors.light.background' "$COLORS_FILE")"
else
  COLOR="$(jq -r '.colors.dark.surface_container // .colors.dark.surface // .colors.dark.background' "$COLORS_FILE")"
fi

[[ -z "$COLOR" || "$COLOR" == "null" ]] && exit 0

POLICY_DIR="/etc/opt/chrome/policies/managed"
POLICY_FILE="$POLICY_DIR/color.json"

# Fast-path: if policy already matches target color, do nothing (avoids IPC spam & lag)
if [[ -f "$POLICY_FILE" ]]; then
  CURRENT_COLOR="$(jq -r '.BrowserThemeColor // empty' "$POLICY_FILE" 2>/dev/null || true)"
  if [[ "$CURRENT_COLOR" == "$COLOR" ]]; then
    exit 0
  fi
fi

cat > "$POLICY_FILE" <<JSON
{
  "BrowserThemeColor": "$COLOR"
}
JSON

# Live reload Chrome policy if running
if pgrep -x "chrome" > /dev/null 2>&1; then
  google-chrome --refresh-platform-policy > /dev/null 2>&1 &
fi
