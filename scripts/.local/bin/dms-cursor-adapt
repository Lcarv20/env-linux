#!/usr/bin/env python3
"""dms-cursor-adapt — make the mouse cursor follow DMS's dynamic theme.

Watches ~/.cache/dms/dms-colors.json (the palette DMS/matugen generates from
your wallpaper) and switches the cursor theme to the installed Bibata variant
whose color is closest to the current accent (primary) color. Dark mode uses
the dark variants, light mode uses the *-Light variants.

It applies the choice everywhere it needs to:
  * ~/.icons/default/index.theme   (the "default" cursor theme pointer)
  * gsettings org.gnome.desktop.interface cursor-theme / cursor-size
  * GTK3/GTK4 settings.ini
  * ~/.Xresources                  (Xwayland-satellite)
  * ~/.config/niri/dms/cursor.kdl  (written exactly like DMS generates it)
  * reloads niri so the compositor cursor changes instantly

Usage:
  dms-cursor-adapt --daemon        run as a watcher (systemd user service)
  dms-cursor-adapt --once          apply once for the current palette
  dms-cursor-adapt --refresh-map   (re)build the theme -> color map
  dms-cursor-adapt --status        show what's going on
"""

import argparse
import json
import re
import struct
import subprocess
import sys
import time
from collections import Counter
from colorsys import rgb_to_hls
from pathlib import Path

HOME = Path.home()
ICON_DIRS = [HOME / ".icons", HOME / ".local/share/icons", Path("/usr/share/icons")]
PALETTE_FILE = HOME / ".cache/dms/dms-colors.json"
DMS_SETTINGS = HOME / ".config/dms/settings.json"
MAP_CACHE = HOME / ".cache/dms/cursor-adapt-map.json"
STATE_FILE = HOME / ".cache/dms/cursor-adapt-state.json"
DEFAULT_INDEX = HOME / ".icons/default/index.theme"
CURSOR_KDL = HOME / ".config/niri/dms/cursor.kdl"
XRESOURCES = HOME / ".Xresources"
GTK_INI = [HOME / ".config/gtk-3.0/settings.ini", HOME / ".config/gtk-4.0/settings.ini"]

FAMILY = "Bibata-Material"          # only consider these theme dirs
LIGHT_SUFFIX = "-Light"
CURSOR_FILES = ["left_ptr", "default", "pointer", "arrow", "xterm"]
XCURSOR_MAGIC = b"Xcur"             # 4 ASCII bytes; the rest of the file is little-endian
CHUNK_IMAGE = 0xFFFD0002
CHROMA_THRESHOLD = 0.18             # below this an accent counts as "neutral"


def log(msg: str) -> None:
    print(f"[dms-cursor-adapt] {msg}", flush=True)


def run(cmd: list) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        return (r.stdout or r.stderr).strip()
    except Exception as e:  # noqa: BLE001
        return f"error: {e}"


# ---------------------------------------------------------------- color utils
def hex_to_hls(h: str):
    h = h.lstrip("#")
    r, g, b = (int(h[i : i + 2], 16) / 255 for i in (0, 2, 4))
    return rgb_to_hls(r, g, b)


def hue_distance(a: float, b: float) -> float:
    d = abs(a - b) % 1.0
    return min(d, 1.0 - d)


# ------------------------------------------------------- xcursor color probe
def xcursor_identity_color(path: Path, want: int = 32):
    """Return the color identity (#rrggbb) of an Xcursor file.

    Bibata Material cursors are a solid body with a contrasting outline ring.
    The body has more pixels, but the outline carries the variant's hue
    (Apricot -> apricot ring, Noir -> grey ring). We rank candidate colors
    by saturation and contrast against the body so we reliably extract the
    accent outline even if the body has minor antialiasing shades.
    """
    try:
        data = path.read_bytes()
        if len(data) < 16 or data[:4] != XCURSOR_MAGIC:
            return None
        _, _, ntoc = struct.unpack_from("<III", data, 4)
        best_pos = None
        for idx in range(ntoc):
            ctype, sub, pos = struct.unpack_from("<III", data, 16 + 12 * idx)
            if ctype != CHUNK_IMAGE:
                continue
            if sub == want:
                best_pos = pos
                break
        if best_pos is None:
            best_pos = struct.unpack_from("<III", data, 16)[2]

        pos = best_pos
        # image chunk header is 36 bytes: hdr,type,subtype,version,w,h,xhot,yhot,delay
        if pos + 36 > len(data):
            return None
        _, _, _, _, w, h, _, _, _ = struct.unpack_from("<IIIIIIIII", data, pos)
        counts = Counter()
        for i in range(w * h):
            off = pos + 36 + 4 * i
            if off + 4 > len(data):
                break
            px = struct.unpack_from("<I", data, off)[0]
            if (px >> 24) < 200:  # skip transparent / antialiased edges
                continue
            counts[px & 0xFFFFFF] += 1
        if not counts:
            return None

        is_light = "-Light" in str(path)
        candidates = [col for col, cnt in counts.most_common(12) if cnt >= 3]
        if not candidates:
            return f"#{counts.most_common(1)[0][0]:06x}"

        def rank_accent(c):
            r = (c >> 16) & 0xFF
            g = (c >> 8) & 0xFF
            b = c & 0xFF
            _, l, s = rgb_to_hls(r / 255.0, g / 255.0, b / 255.0)
            return (s, l if not is_light else (1.0 - l))

        accent = max(candidates, key=rank_accent)
        return f"#{accent:06x}"
    except Exception:  # noqa: BLE001
        return None


def find_theme_dirs():
    out = {}
    for base in ICON_DIRS:
        if not base.is_dir():
            continue
        for d in base.iterdir():
            if d.is_dir() and (d / "cursors").is_dir() and d.name.startswith(FAMILY):
                out.setdefault(d.name, d)
    return out


def build_map() -> dict:
    themes = find_theme_dirs()
    if not themes:
        log(f"no '{FAMILY}*' cursor themes found in {', '.join(str(p) for p in ICON_DIRS)}")
        return {}
    mapping = {}
    for name, path in sorted(themes.items()):
        color = None
        for fname in CURSOR_FILES:
            cfile = path / "cursors" / fname
            if cfile.exists():
                color = xcursor_identity_color(cfile)
                if color:
                    break
        if color:
            mapping[name] = color
        else:
            log(f"warning: could not probe color for {name}")
    MAP_CACHE.parent.mkdir(parents=True, exist_ok=True)
    MAP_CACHE.write_text(json.dumps(mapping, indent=2))
    log(f"color map: {len(mapping)} themes -> {MAP_CACHE}")
    return mapping


def load_map() -> dict:
    if MAP_CACHE.exists():
        try:
            cached = json.loads(MAP_CACHE.read_text())
            if set(cached) == set(find_theme_dirs()):
                return cached
        except Exception:  # noqa: BLE001
            pass
    return build_map()


# ------------------------------------------------------------- pick a variant
def pick_variant(accent_hex: str, mode: str, color_map: dict):
    hue, light, sat = hex_to_hls(accent_hex)
    want_light = mode == "light"
    pool = {
        name: hex_to_hls(c)
        for name, c in color_map.items()
        if name.endswith(LIGHT_SUFFIX) == want_light
    }
    if not pool:
        return None
    accent_chromatic = sat >= CHROMA_THRESHOLD

    def score(item):
        _, (th, tl, ts) = item
        theme_chromatic = ts >= CHROMA_THRESHOLD
        if accent_chromatic != theme_chromatic:
            return 99.0
        if accent_chromatic:
            # Hue distance dominates so color families match correctly (e.g. yellow vs green)
            return hue_distance(hue, th) * 8.0 + abs(sat - ts) * 0.5 + abs(light - tl) * 0.3
        return abs(light - tl) + 0.3 * abs(sat - ts)

    return min(pool.items(), key=score)[0]


# --------------------------------------------------------------- read inputs
def read_palette():
    if not PALETTE_FILE.exists():
        return None, None
    try:
        data = json.loads(PALETTE_FILE.read_text())
    except Exception:  # noqa: BLE001
        return None, None
    mode = data.get("mode", "dark")
    colors = data.get("colors", {}).get(mode, {})
    accent = colors.get("primary") or colors.get("primary_container")
    if not accent:
        dank = data.get("dank16", {})
        accent = dank.get("color5", {}).get(mode) or dank.get("color6", {}).get(mode)
    return mode, accent


def read_dms_cursor_settings() -> dict:
    try:
        s = json.loads(DMS_SETTINGS.read_text()).get("cursorSettings", {})
        return {
            "size": s.get("size", 24),
            "hideWhenTyping": bool((s.get("niri") or {}).get("hideWhenTyping", False)),
            "hideAfterInactiveMs": int((s.get("niri") or {}).get("hideAfterInactiveMs", 0)),
        }
    except Exception:  # noqa: BLE001
        return {"size": 24, "hideWhenTyping": False, "hideAfterInactiveMs": 0}


# ------------------------------------------------------------------- applying
def replace_in_file(path: Path, pattern: str, repl: str, append_section=None):
    if path.exists():
        text = path.read_text()
        new = re.sub(pattern, repl, text, flags=re.M)
        if new != text:
            path.write_text(new)
            return
        if re.search(pattern, text, flags=re.M):
            return
    if append_section:
        path.parent.mkdir(parents=True, exist_ok=True)
        body = path.read_text() if path.exists() else append_section + "\n"
        if not body.endswith("\n"):
            body += "\n"
        path.write_text(body + repl + "\n")


def apply_theme(theme: str, size: int):
    # 1. the "default" cursor theme pointer (used by anything resolving 'default')
    DEFAULT_INDEX.parent.mkdir(parents=True, exist_ok=True)
    DEFAULT_INDEX.write_text(
        "[Icon Theme]\n"
        "Name=Default\n"
        "Comment=Default Cursor Theme (managed by dms-cursor-adapt)\n"
        f"Inherits={theme}\n"
    )
    # symlink mirrors so both lookup paths agree
    for link in (HOME / ".local/share/icons/default",):
        try:
            if link.is_symlink() and link.resolve() == Path("/usr/share/icons/default"):
                link.unlink()
                link.symlink_to(HOME / ".icons/default")
        except Exception:  # noqa: BLE001
            pass

    # 2. gsettings / dconf (GTK apps, and DMS's own "System Default" detection)
    run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", theme])
    run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", str(size)])

    # 3. GTK settings.ini
    for ini in GTK_INI:
        replace_in_file(
            ini,
            r"^gtk-cursor-theme-name\s*=.*$",
            f"gtk-cursor-theme-name={theme}",
            append_section="[Settings]",
        )
        replace_in_file(
            ini,
            r"^gtk-cursor-theme-size\s*=.*$",
            f"gtk-cursor-theme-size={size}",
            append_section="[Settings]",
        )

    # 4. ~/.Xresources (xwayland-satellite picks new sessions up from here)
    replace_in_file(
        XRESOURCES,
        r"^\s*Xcursor\.theme:.*$",
        f"Xcursor.theme: {theme}",
        append_section="! cursor",
    )
    replace_in_file(
        XRESOURCES,
        r"^\s*Xcursor\.size:.*$",
        f"Xcursor.size: {size}",
        append_section="! cursor",
    )

    # 5. niri cursor config — byte-compatible with what DMS itself generates,
    #    so a DMS regeneration produces the same behaviour.
    s = read_dms_cursor_settings()
    body = (
        "// ! DO NOT EDIT !\n"
        "// ! AUTO-GENERATED BY DMS !\n"
        "// ! CHANGES WILL BE OVERWRITTEN !\n"
        "// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !\n\n"
        "cursor {\n"
        f'    xcursor-theme "{theme}"\n'
        f"    xcursor-size {size}\n"
    )
    if s["hideWhenTyping"]:
        body += "    hide-when-typing\n"
    if s["hideAfterInactiveMs"] > 0:
        body += f"    hide-after-inactive-ms {s['hideAfterInactiveMs']}\n"
    body += "}\n"
    CURSOR_KDL.parent.mkdir(parents=True, exist_ok=True)
    CURSOR_KDL.write_text(body)

    # 6. live-reload niri so the compositor cursor updates immediately
    run(["niri", "msg", "action", "load-config-file"])


def save_state(theme: str, mode: str, accent: str):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps({"theme": theme, "mode": mode, "accent": accent}))


def apply_once(color_map: dict = None, force: bool = False) -> str | None:
    color_map = color_map or load_map()
    if not color_map:
        return None
    # Gating: the adaptive cursor is only allowed while DMS's cursor setting
    # is "System Default". The dankCursorAdapt plugin enforces this too.
    try:
        dms_theme = json.loads(DMS_SETTINGS.read_text()).get("cursorSettings", {}).get("theme", "System Default")
    except Exception:  # noqa: BLE001
        dms_theme = "System Default"
    if dms_theme != "System Default" and not force:
        log(f"standing down: DMS cursor theme is '{dms_theme}' (not System Default). Use --force to override.")
        return None
    mode, accent = read_palette()
    if not accent:
        log(f"no palette found at {PALETTE_FILE} (is DMS running?)")
        return None
    theme = pick_variant(accent, mode, color_map)
    if not theme:
        log("no matching variant available")
        return None
    size = read_dms_cursor_settings()["size"]
    state = {}
    if STATE_FILE.exists():
        try:
            state = json.loads(STATE_FILE.read_text())
        except Exception:  # noqa: BLE001
            pass
    if state.get("theme") == theme and CURSOR_KDL.exists():
        log(f"already using {theme} (mode={mode}, accent={accent})")
        return theme
    apply_theme(theme, size)
    save_state(theme, mode, accent)
    log(f"applied {theme}  (mode={mode}, accent={accent}, size={size})")
    return theme


def daemon():
    log("daemon started")
    color_map = load_map()
    seen = None
    while True:
        try:
            key = None
            if PALETTE_FILE.exists():
                key = f"{PALETTE_FILE.stat().st_mtime_ns}:{PALETTE_FILE.stat().st_size}"
            if key != seen:
                seen = key
                time.sleep(1.0)  # let DMS finish writing the file
                color_map = load_map()
                apply_once(color_map)
        except KeyboardInterrupt:
            log("stopping")
            return
        except Exception as e:  # noqa: BLE001
            log(f"error: {e}")
        time.sleep(2.0)


def status():
    mode, accent = read_palette()
    color_map = load_map()
    state = {}
    if STATE_FILE.exists():
        try:
            state = json.loads(STATE_FILE.read_text())
        except Exception:  # noqa: BLE001
            pass
    print(f"palette file : {PALETTE_FILE} ({'present' if PALETTE_FILE.exists() else 'MISSING'})")
    print(f"mode / accent: {mode} / {accent}")
    print(f"variants     : {len(color_map)} mapped")
    if accent:
        print(f"would pick   : {pick_variant(accent, mode or 'dark', color_map)}")
    print(f"last applied : {state.get('theme')} (mode={state.get('mode')}, accent={state.get('accent')})")
    print(f"gsettings    : {run(['gsettings', 'get', 'org.gnome.desktop.interface', 'cursor-theme'])}")
    print(f"niri cursor  : {CURSOR_KDL} -> "
          f"{[l.strip() for l in CURSOR_KDL.read_text().splitlines() if 'xcursor-theme' in l] if CURSOR_KDL.exists() else 'missing'}")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--daemon", action="store_true", help="watch the palette and adapt continuously")
    ap.add_argument("--once", action="store_true", help="apply once for the current palette (gated: only when DMS cursor theme is System Default)")
    ap.add_argument("--force", action="store_true", help="with --once: apply even if the DMS cursor theme is not System Default")
    ap.add_argument("--refresh-map", action="store_true", help="rebuild the theme -> color map")
    ap.add_argument("--status", action="store_true", help="print current state")
    args = ap.parse_args()

    if args.refresh_map:
        build_map()
        return
    if args.status:
        status()
        return
    if args.daemon:
        daemon()
        return
    if args.once:
        apply_once(force=args.force)
        return
    status()


if __name__ == "__main__":
    main()
